# Als .env.local im Projektordner auf dem Server anlegen:
#   cp .env.example .env.local
# Alles hier ist serverseitig – nichts davon landet im Browser.
# Nach jeder Änderung: pm2 restart soulstealer-overlay (bzw. docker compose up -d)

# --- Allgemein ----------------------------------------------------------------
# Die öffentliche Adresse des Overlays, ohne Slash am Ende.
PUBLIC_URL=https://overlay.soul-stealer.com
# Langes, zufälliges Passwort. Schützt den Spotify-Verbinden-Link.
# Erzeugen z.B. mit: openssl rand -hex 24
OVERLAY_ADMIN_KEY=
# Wo die App Daten speichert (Spotify-Token). Standard: ./data
# DATA_DIR=

# --- Kick-Chat ---------------------------------------------------------------
# Kanalname wie in kick.com/<name>. Standard steht in lib/config.ts (CHAT.channel).
# KICK_CHANNEL=soulstealer
# Optional: Chatroom-ID direkt angeben, falls Kick die Abfrage vom Server blockt
# (README, Abschnitt 5).
# KICK_CHATROOM_ID=

# --- bonushunt.gg -------------------------------------------------------------
# Derselbe API-Key, den soul-stealer.com nutzt.
BONUSHUNT_API_KEY=
# Wie viele Stunden ein abgeschlossener Hunt noch als Ergebnis sichtbar bleibt.
# 0 = nie. Standard: 12
BONUSHUNT_SHOW_COMPLETED_HOURS=12

# --- Giveaway (Admin-Modul auf soul-stealer.com) ------------------------------
# Endpunkt auf der Website, der den aktuellen Giveaway-Zustand als JSON liefert.
# Format: siehe README, Abschnitt "Giveaway".
GIVEAWAY_API_URL=
# Optional: wird als "Authorization: Bearer <key>" mitgeschickt.
GIVEAWAY_API_KEY=

# --- Spotify (developer.spotify.com/dashboard) --------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Standard: PUBLIC_URL + /api/spotify/callback
# SPOTIFY_REDIRECT_URI=
# Optional. Wird nur benutzt, wenn noch kein Konto über den Login verbunden ist.
# SPOTIFY_REFRESH_TOKEN=
